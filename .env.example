# Copy this file to .env and fill in the values. Never commit .env.
# Gmail needs an "app password" (requires 2-step verification):
# https://myaccount.google.com/apppasswords
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# LLM scoring (Phase 4): one of the two keys is enough.
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# or the Anthropic API directly (also needs `pip install anthropic`):
# ANTHROPIC_API_KEY=sk-ant-...
